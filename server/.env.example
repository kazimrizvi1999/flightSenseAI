# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_string

# ─── Frontend origin (CORS) ───────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Amadeus API ─────────────────────────────────────────────────────────────
# Sign up at https://developers.amadeus.com — free test credentials available
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
# 'test' for the Amadeus sandbox, 'production' for live data
AMADEUS_HOSTNAME=test

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Nodemailer / SMTP ───────────────────────────────────────────────────────
# Example: Gmail SMTP with an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
