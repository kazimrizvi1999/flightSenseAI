# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a long, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_string

# ─── Frontend origin (CORS) ───────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── AviationStack API (Real-Time Flight Data) ───────────────────────────────
# Sign up free at https://aviationstack.com — 100 calls/month free
AVIATIONSTACK_KEY=your_aviationstack_key_here

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Nodemailer / SMTP ───────────────────────────────────────────────────────
# Example: Gmail SMTP with an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
