# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string

# ─── Frontend origin (CORS) ───────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Sky-Scrapper via RapidAPI (Real-Time Flight Data) ───────────────────────
# 1. Go to https://rapidapi.com — create a free account
# 2. Search "Sky Scrapper" → click "Subscribe to Test" (free tier)
# 3. Copy your key from the Header Parameters section (X-RapidAPI-Key)
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Nodemailer / SMTP ────────────────────────────────────────────────────────
# Gmail example: enable 2FA on your Google account, then create an App Password
# at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
