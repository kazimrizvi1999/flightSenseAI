# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_string

# ─── Frontend origin (CORS) ───────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ─── Amadeus API ──────────────────────────────────────────────────────────────
# Sign up free at https://developers.amadeus.com
# Create an app under "Self-Service" to get these credentials
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
# Use 'test' for sandbox (free), 'production' for live data
AMADEUS_HOSTNAME=test

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Nodemailer / SMTP ────────────────────────────────────────────────────────
# Gmail example: enable 2FA on your Google account, then create an App Password
# at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
